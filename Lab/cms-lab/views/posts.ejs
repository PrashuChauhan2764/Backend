<!DOCTYPE html>
<html>
<head>
    <title>Simple CMS</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>Simple CMS</h1>

    <!-- Link to create a new post -->
    <a href="/posts/new">Create New Post</a>

    <hr>

    <h2>All Posts</h2>

    <!-- Display each post -->
    <% posts.forEach(post => { %>

    <div class="post">

        <h3>
            <a href="/posts/<%= post._id %>">
                <%= post.title %>
            </a>
        </h3>

        <p>By <%= post.author %></p>

        <p>
            <%= post.createdAt.toLocaleDateString("en-GB", {
                day: "numeric",
                month: "long",
                year: "numeric"
            }) %>
        </p>

    </div>

<% }) %>

</body>
</html>